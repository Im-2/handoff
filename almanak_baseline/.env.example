# Required
# Well-known public Foundry/Anvil/Hardhat test key (account #0), holds 0 real funds.
# Fine for decisioning (balance/price reads only, never signs a real tx) and
# for the Anvil-fork baseline. Swap in your own throwaway key if you prefer.
ALMANAK_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# RPC access -- an archive-capable RPC is required for the Anvil-fork baseline
# (free public RPCs are state-pruned and Almanak will refuse to fork against
# them); dry-run/live decisioning works against free public RPCs too, just
# less reliably.
ALCHEMY_API_KEY=...

# Optional
# ALMANAK_GATEWAY_PRIVATE_KEY=  # falls back to ALMANAK_PRIVATE_KEY if unset
# ENSO_API_KEY=
# COINGECKO_API_KEY=
# ALMANAK_API_KEY=
